# ---------------------------------------------------------------------------
# Vertical AI Operations Agent — example configuration.
# Copy to `.env` for local development. NEVER commit a real `.env` (rule 6).
# Every value below is a placeholder; the app runs in sandbox mode without any
# credentials at all, which is how CI and the demo profile execute.
# ---------------------------------------------------------------------------

# Core
AIOPS_ENV=development                # development | test | staging | production
AIOPS_LOG_LEVEL=INFO
AIOPS_API_PREFIX=/api/v1
AIOPS_REQUEST_TIMEOUT_SECONDS=10

# Database — PostgreSQL is the system of record.
# Docker/local: postgresql+psycopg://aiops:aiops@localhost:5432/aiops
# SQLite is supported for unit tests and single-node demos only (see ADR-0005).
AIOPS_DATABASE_URL=postgresql+psycopg://aiops:aiops@localhost:5432/aiops

# Authentication — static bearer tokens for the MVP (see ADR-0008 / SEC-002).
# format: token:role:actor_id  (comma separated) — override in secret manager.
AIOPS_API_TOKENS=dev-viewer-token:viewer:dev-viewer,dev-operator-token:operator:dev-operator,dev-sre-token:sre:dev-sre,dev-admin-token:admin:dev-admin

# Integrations — "sandbox" uses the in-process SaaS simulator, "live" calls real APIs.
AIOPS_INTEGRATIONS_MODE=sandbox

# GitHub
AIOPS_GITHUB_TOKEN=
AIOPS_GITHUB_API_URL=https://api.github.com
AIOPS_GITHUB_REPOSITORY=acme/checkout-service

# Jira
AIOPS_JIRA_URL=
AIOPS_JIRA_TOKEN=
AIOPS_JIRA_EMAIL=
AIOPS_JIRA_PROJECT_KEY=OPS

# Slack
AIOPS_SLACK_WEBHOOK_URL=
AIOPS_SLACK_TOKEN=
AIOPS_SLACK_CHANNEL=#ops-incidents

# Metrics / logs (Prometheus-compatible + Loki-compatible)
AIOPS_METRICS_URL=
AIOPS_METRICS_TOKEN=
AIOPS_LOGS_URL=
AIOPS_LOGS_TOKEN=

# Payments
AIOPS_PAYMENTS_URL=
AIOPS_PAYMENTS_TOKEN=

# LLM — OpenAI-compatible chat-completions endpoint.
# If AIOPS_LLM_API_KEY is empty the agent uses the deterministic offline
# reasoner (see ADR-0006); behaviour is fully labelled in API responses.
AIOPS_LLM_BASE_URL=https://api.openai.com/v1
AIOPS_LLM_API_KEY=
AIOPS_LLM_MODEL=gpt-4o-mini
AIOPS_LLM_TIMEOUT_SECONDS=30
AIOPS_LLM_MAX_RETRIES=2
AIOPS_LLM_TEMPERATURE=0.0

# Detection tuning (OPS-030)
AIOPS_DETECTION_WINDOW_MINUTES=60
AIOPS_DETECTION_MIN_SAMPLES=12
AIOPS_DETECTION_Z_THRESHOLD=4.0
AIOPS_DETECTION_MIN_RELATIVE_DEVIATION=0.5

# Policy / autonomy (SEC-002, section 39 V6)
AIOPS_AUTONOMY_LEVEL=approval_required   # observe_only | approval_required | selective_autonomy
AIOPS_ACTOR_ROLE=sre
